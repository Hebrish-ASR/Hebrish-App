 "engine_rules": [
  {
   "rule": "trailing silence before decode",
   "android": "0.8 s zeros after trim (core/Transcriber.kt:27)",
   "desktop": "1.0 s (engine.TAIL_PAD_S)",
   "same": false,
   "explained_by": "Both above the measured 0.6 s minimum (shared/models.json min_trailing_silence_s); the gap is unmeasured"
  },
  {
   "rule": "leading/trailing silence",
   "android": "trimmed, 0.35 s kept each side (Transcriber.kt:122)",
   "desktop": "not trimmed; with vad, silences over 1.5 s cut to 0.8 s (engine.shorten_silences)",
   "same": false,
   "explained_by": ""
  },
  {
   "rule": "inner pauses",
   "android": "kept as recorded",
   "desktop": "0.12-0.6 s pauses stretched to 0.6 s (engine.stretch_pauses)",
   "same": false,
   "explained_by": "desktop/docs/maintaining.md: 0.3 s gaps lost sentences, 6/8 -> 8/8 with stretching (v4, 2026-10-18); not measured on Android"
  },
  {
   "rule": "long-take chunking",
   "android": "no cut before 8 s, cut at a 0.6 s pause, hard cut at 28 s (core/Recorder.kt:36)",
   "desktop": "pieces >= ~10 s cut at a 0.6 s pause, forced at interval + 15 s (engine.live_cut, split_points)",
   "same": false,
   "explained_by": "Same 0.6 s pause rule; minimum and forced lengths differ, unmeasured"
  },
  {
   "rule": "no-speech takes",
   "android": "decoded; 'Heard nothing' on empty text",
   "desktop": "not decoded when vad is on (engine.has_speech)",
   "same": false,
   "explained_by": "desktop 0.5.0 (Daniel, 2026-10-21)"
  },
  {
   "rule": "normalisation",
   "android": "none (int16/32768)",
   "desktop": "RMS to -20 dBFS, gain at most 10x (engine.normalize)",
   "same": false,
   "explained_by": ""
  },
  {
   "rule": "sample rate",

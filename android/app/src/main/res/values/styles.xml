<resources>
    <!--
    The app's screens in the Hebrish brand (0.10.0, Daniel 2026-10-23: "make it look a little bit
    more professional and slick"): paper background, green accent, a flat bar in the page colour,
    tonal buttons. Material rather than DeviceDefault, so it looks the same on every phone; the
    night variant is values-night/styles.xml. Up to 0.9.x: Theme.DeviceDefault.DayNight with the
    blue @color/accent. The keyboard and the floating mic don't use this theme.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light">
        <item name="android:colorPrimary">@color/brand_bg</item>
        <item name="android:colorPrimaryDark">@color/brand_bg</item>
        <item name="android:colorAccent">@color/brand_accent</item>
        <item name="android:colorControlNormal">@color/brand_muted</item>
        <item name="android:colorBackground">@color/brand_bg</item>
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:textColorPrimary">@color/brand_ink</item>
        <item name="android:textColorSecondary">@color/brand_muted</item>
        <item name="android:textColorLink">@color/brand_accent</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:actionBarStyle">@style/AppBar</item>
        <item name="android:buttonStyle">@style/AppButton</item>
    </style>

    <style name="AppBar" parent="@android:style/Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">@color/brand_bg</item>
        <item name="android:elevation">0dp</item>
        <item name="android:titleTextStyle">@style/AppBarTitle</item>
    </style>

    <style name="AppBarTitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Tonal button: soft green fill, green text, rounded, no capitals. Page.primary() is the filled one. -->
    <style name="AppButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/brand_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>

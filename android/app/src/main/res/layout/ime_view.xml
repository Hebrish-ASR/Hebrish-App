<?xml version="1.0" encoding="utf-8"?>
<!-- Voice keyboard (0.6.0 layout, Daniel 2026-10-20): header with the Hebrish mark (so it's clear
     which keyboard this is) and a settings gear, the mic always at the top, take controls under it,
     and the key row at the bottom: keyboard, comma, period, space, delete, enter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_bg"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/brand"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_hebrish" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/app_name"
            android:textColor="@color/ime_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/ime_text"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/mic"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/mic_bg"
        android:contentDescription="@string/cd_mic"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic" />

    <View
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/level_bar"
        android:scaleX="0.02" />

    <LinearLayout
        android:id="@+id/take_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <Button
            android:id="@+id/pause"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:text="@string/pause"
            android:textAllCaps="false"
            android:textColor="@color/ime_text" />
        <Button
            android:id="@+id/restart"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:text="@string/restart"
            android:textAllCaps="false"
            android:textColor="@color/ime_text" />
        <Button
            android:id="@+id/discard"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:text="@string/discard"
            android:textAllCaps="false"
            android:textColor="@color/ime_text" />
    </LinearLayout>

    <Button
        android:id="@+id/insert_last"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/key_bg"
        android:text="@string/insert_last"
        android:textAllCaps="false"
        android:textColor="@color/ime_text"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/switch_ime"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_switch"
            android:src="@drawable/ic_keyboard" />

        <Button
            android:id="@+id/comma"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="0.8"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_comma"
            android:text=","
            android:textColor="@color/ime_text"
            android:textSize="22sp" />

        <Button
            android:id="@+id/period"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="0.8"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_period"
            android:text="."
            android:textColor="@color/ime_text"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="2.4"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_space"
            android:src="@drawable/ic_space" />

        <ImageButton
            android:id="@+id/backspace"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_backspace"
            android:src="@drawable/ic_backspace" />

        <ImageButton
            android:id="@+id/enter"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_enter"
            android:src="@drawable/ic_enter" />
    </LinearLayout>
</LinearLayout>

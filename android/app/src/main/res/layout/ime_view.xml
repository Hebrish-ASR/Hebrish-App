<?xml version="1.0" encoding="utf-8"?>
<!-- Voice keyboard: a header with status, mic source and settings, one row of round take controls
     with the mic in the middle (1.007), an edit row (1.031: cursor, delete word, delete sentence),
     and the key row at the bottom: keyboard, comma, period,
     space, delete, enter. 1.019 (Daniel 2026-11-06): the Hebrish mark and name are gone and every
     row is tighter, because VoiceImeService adds the navigation bar's height under the key row and
     the whole keyboard should still be no taller than before. See docs/maintaining.md. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_bg"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/ime_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Mic source chip (1.008, Daniel 2026-10-30: "a one touch operation ... to toggle
             between internal mic and BT audio source"): names the mic the next or current take
             uses; a tap opens the mic icons beside it, mid-take too (VoiceImeService.openPicker, 1.018). -->
        <TextView
            android:id="@+id/source"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/key_bg"
            android:drawableStart="@drawable/ic_mic"
            android:drawablePadding="4dp"
            android:drawableTint="@color/ime_text"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:maxWidth="120dp"
            android:paddingHorizontal="10dp"
            android:textColor="@color/ime_text"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Control row (1.007, Daniel 2026-10-27: "pause, retake, discard need to be easier to find and
         easier to click ... a consistent row ... you shouldn't have to scroll down"). Always the
         same five buttons, so the keyboard never changes height: Discard and Retake on the left,
         the mic in the middle, Pause and Insert last on the right. Buttons that don't apply are
         dimmed, not hidden (renderTake). Up to 1.006 the controls were a row of grey text keys
         that appeared under the mic only while recording, which pushed the key row down. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/discard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/bubble_discard"
                android:contentDescription="@string/action_discard"
                android:foreground="@drawable/ime_round_press"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
            <TextView
                android:id="@+id/discard_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/discard"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/restart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/bubble_retake"
                android:contentDescription="@string/action_restart"
                android:foreground="@drawable/ime_round_press"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_retake" />
            <TextView
                android:id="@+id/restart_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/restart"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/mic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/ime_mic_idle"
                android:contentDescription="@string/cd_mic"
                android:foreground="@drawable/ime_round_press"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />
            <TextView
                android:id="@+id/mic_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/ime_lbl_record"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/ime_pause"
                android:contentDescription="@string/action_pause"
                android:foreground="@drawable/ime_round_press"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause" />
            <TextView
                android:id="@+id/pause_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/pause"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/insert_last"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/ime_insert"
                android:contentDescription="@string/insert_last"
                android:foreground="@drawable/ime_round_press"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_paste" />
            <TextView
                android:id="@+id/insert_last_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/ime_lbl_insert"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/level_bar"
        android:scaleX="0.02" />

    <!-- Edit row (1.031, Daniel 2026-11-12: fix little things in the dictated text "without needing
         to go back to the full keyboard"): cursor left, delete the last word, delete the last
         sentence, cursor right. The arrows repeat while held. See docs/maintaining.md. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/cursor_left"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_cursor_left"
            android:src="@drawable/ic_cursor_left" />

        <Button
            android:id="@+id/delete_word"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:layout_weight="2"
            android:background="@drawable/key_bg"
            android:drawableStart="@drawable/ic_backspace_small"
            android:drawableTint="@color/ime_text"
            android:paddingHorizontal="12dp"
            android:text="@string/ime_delete_word"
            android:textAllCaps="false"
            android:textColor="@color/ime_text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/delete_sentence"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:layout_weight="2"
            android:background="@drawable/key_bg"
            android:drawableStart="@drawable/ic_backspace_small"
            android:drawableTint="@color/ime_text"
            android:paddingHorizontal="12dp"
            android:text="@string/ime_delete_sentence"
            android:textAllCaps="false"
            android:textColor="@color/ime_text"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/cursor_right"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_cursor_right"
            android:src="@drawable/ic_cursor_right" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/switch_ime"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="1.2"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_switch"
            android:src="@drawable/ic_keyboard"
            android:tint="@color/ime_switch" />

        <Button
            android:id="@+id/comma"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="0.8"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_comma"
            android:text=","
            android:textColor="@color/ime_text"
            android:textSize="22sp" />

        <Button
            android:id="@+id/period"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="0.8"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_period"
            android:text="."
            android:textColor="@color/ime_text"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="1.8"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_space"
            android:src="@drawable/ic_space" />

        <ImageButton
            android:id="@+id/backspace"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="1.2"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_backspace"
            android:src="@drawable/ic_backspace" />

        <ImageButton
            android:id="@+id/enter"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="1.2"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_enter"
            android:src="@drawable/ic_enter" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Voice keyboard (0.6.0 layout, Daniel 2026-10-20): header with the Hebrish mark (so it's clear
     which keyboard this is) and a settings gear, one row of round take controls with the mic in the middle (1.007),
     and the key row at the bottom: keyboard, comma, period, space, delete, enter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_bg"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/brand"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_hebrish" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/app_name"
            android:textColor="@color/ime_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/ime_text"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Control row (1.007, Daniel 2026-10-27: "pause, retake, discard need to be easier to find and
         easier to click ... a consistent row ... you shouldn't have to scroll down"). Always the
         same five buttons, so the keyboard never changes height: Discard and Retake on the left,
         the mic in the middle, Pause and Insert last on the right. Buttons that don't apply are
         dimmed, not hidden (renderTake). Up to 1.006 the controls were a row of grey text keys
         that appeared under the mic only while recording, which pushed the key row down. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/discard"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/bubble_discard"
                android:contentDescription="@string/action_discard"
                android:foreground="@drawable/ime_round_press"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
            <TextView
                android:id="@+id/discard_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/discard"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/restart"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/bubble_retake"
                android:contentDescription="@string/action_restart"
                android:foreground="@drawable/ime_round_press"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_retake" />
            <TextView
                android:id="@+id/restart_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/restart"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/mic"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/ime_mic_idle"
                android:contentDescription="@string/cd_mic"
                android:foreground="@drawable/ime_round_press"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />
            <TextView
                android:id="@+id/mic_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/ime_lbl_record"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/ime_pause"
                android:contentDescription="@string/action_pause"
                android:foreground="@drawable/ime_round_press"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause" />
            <TextView
                android:id="@+id/pause_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/pause"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/insert_last"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ime_round"
                android:backgroundTint="@color/ime_insert"
                android:contentDescription="@string/insert_last"
                android:foreground="@drawable/ime_round_press"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_paste" />
            <TextView
                android:id="@+id/insert_last_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/ime_lbl_insert"
                android:textColor="@color/ime_label"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/level_bar"
        android:scaleX="0.02" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/switch_ime"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_switch"
            android:src="@drawable/ic_keyboard" />

        <Button
            android:id="@+id/comma"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="0.8"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_comma"
            android:text=","
            android:textColor="@color/ime_text"
            android:textSize="22sp" />

        <Button
            android:id="@+id/period"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="0.8"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_period"
            android:text="."
            android:textColor="@color/ime_text"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="2.4"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_space"
            android:src="@drawable/ic_space" />

        <ImageButton
            android:id="@+id/backspace"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_backspace"
            android:src="@drawable/ic_backspace" />

        <ImageButton
            android:id="@+id/enter"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="1.2"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/cd_enter"
            android:src="@drawable/ic_enter" />
    </LinearLayout>
</LinearLayout>

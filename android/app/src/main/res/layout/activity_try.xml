<?xml version="1.0" encoding="utf-8"?>
<!-- "Try it": notepad + mic. TryActivity records and decodes in-app, no keyboard setup. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:orientation="vertical" android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/try_title" android:textAppearance="?android:attr/textAppearanceLarge"
        android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/try_instructions" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/try_examples_title" android:textStyle="bold" />
    <LinearLayout android:id="@+id/try_examples" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" />

    <EditText android:id="@+id/try_text" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="10dp" android:layout_weight="1" android:gravity="top|start"
        android:hint="@string/try_text_hint" android:inputType="textMultiLine|textCapSentences"
        android:importantForAutofill="no" android:padding="10dp" android:textSize="17sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/try_copy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/try_copy" style="?android:attr/borderlessButtonStyle" />
        <Button android:id="@+id/try_share" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/try_share" style="?android:attr/borderlessButtonStyle" />
        <Button android:id="@+id/try_clear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/try_clear" style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <TextView android:id="@+id/try_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center" android:minLines="2" />
    <ProgressBar android:id="@+id/try_level" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="160dp" android:layout_height="6dp" android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp" android:max="100" android:progressDrawable="@drawable/level_bar"
        android:visibility="invisible" />
    <ImageButton android:id="@+id/try_mic" android:layout_width="96dp" android:layout_height="96dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="8dp"
        android:background="@drawable/mic_bg" android:contentDescription="@string/cd_mic"
        android:scaleType="centerInside" android:src="@drawable/ic_mic" />

    <Button android:id="@+id/try_setup" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="8dp"
        android:text="@string/try_setup" style="?android:attr/borderlessButtonStyle" />
</LinearLayout>

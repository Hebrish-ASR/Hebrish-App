<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Feedback (0.6.0): the optional buzz at start / stop / retake. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Transcription Mode in the background (I-15, optional in Setup): a microphone foreground
         service, and notifications for its Pause / Stop controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Mic (0.6.0): routing a take to a Bluetooth headset mic (setCommunicationDevice / SCO). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Used once, to download the model from Hugging Face. Recognition itself is offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The floating mic guide's "Keep it running" step asks to be exempt from battery
         optimisation, so OxygenOS and similar don't kill the accessibility service (0.4.0). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screens reached from home (0.4.0); Up returns to MainActivity. -->
        <activity android:name=".ModelsActivity" android:exported="false" android:label="@string/title_models" android:parentActivityName=".MainActivity" />
        <activity android:name=".KeyboardActivity" android:exported="false" android:label="@string/title_keyboard" android:parentActivityName=".MainActivity" />
        <activity android:name=".FloatingMicActivity" android:exported="false" android:label="@string/title_bubble" android:parentActivityName=".MainActivity" />
        <activity android:name=".FloatingMicGuideActivity" android:exported="false" android:label="@string/title_guide" android:parentActivityName=".MainActivity" />
        <activity android:name=".TranscriptionActivity" android:exported="false" android:label="@string/title_transcription" android:parentActivityName=".MainActivity" android:windowSoftInputMode="adjustResize" />
        <service android:name=".TranscriptionService" android:exported="false" android:foregroundServiceType="microphone" />
        <activity android:name=".DictationActivity" android:exported="false" android:label="@string/title_dictation" android:parentActivityName=".MainActivity" />
        <activity android:name=".FloatingMicConsentActivity" android:exported="false" android:label="@string/title_consent" android:parentActivityName=".MainActivity" />
        <activity android:name=".InstallActivity" android:exported="false" android:label="@string/title_install" android:parentActivityName=".MainActivity" />
        <activity android:name=".DictionaryActivity" android:exported="false" android:label="@string/title_dictionary" android:parentActivityName=".MainActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ControlsActivity" android:exported="false" android:label="@string/title_controls" android:parentActivityName=".MainActivity" />
        <activity android:name=".SetupActivity" android:exported="false" android:label="@string/title_setup" android:parentActivityName=".MainActivity" />
        <activity android:name=".AboutActivity" android:exported="false" android:label="@string/title_about" android:parentActivityName=".MainActivity" />
        <activity android:name=".ContactActivity" android:exported="false" android:label="@string/title_contact" android:parentActivityName=".MainActivity" />

        <activity
            android:name=".TryActivity"
            android:exported="false"
            android:label="@string/try_title"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".VoiceImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- The floating mic. Enabled by the user in Accessibility settings; nothing else can bind it. -->
        <service
            android:name=".FloatingMicService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/floating_mic" />
        </service>
    </application>
</manifest>

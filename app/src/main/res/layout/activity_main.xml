<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textAppearance="?android:attr/textAppearanceLarge" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/intro" />
<TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/step_model" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" />
<TextView android:id="@+id/model_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
<ProgressBar android:id="@+id/model_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="1000" android:visibility="gone" />
<Button android:id="@+id/download" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/download" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/step_mic" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" />
<TextView android:id="@+id/mic_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
<Button android:id="@+id/grant_mic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/grant" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/step_ime" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" />
<TextView android:id="@+id/ime_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/enable_ime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/enable" /><Button android:id="@+id/pick_ime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pick" /></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/step_heliboard" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/heliboard_body" />
<Button android:id="@+id/get_heliboard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/get_heliboard" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/step_options" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" />
<Switch android:id="@+id/auto_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/auto_start" />
<Switch android:id="@+id/auto_return" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/auto_return" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/step_try" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" />
<EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/try_hint" android:inputType="textMultiLine|textCapSentences" android:minLines="3" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/links" android:textAppearance="?android:attr/textAppearanceMedium" android:textStyle="bold" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/open_model" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/open_model" /><Button android:id="@+id/open_dataset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/open_dataset" /></LinearLayout>
</LinearLayout>
</ScrollView>
